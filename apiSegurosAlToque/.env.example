# --- San Cristóbal: UAT vs producción ---
# El usuario/clave B2B te los da SC por AMBIENTE: los de UAT existen solo en UAT, no en producción (y viceversa).
# SC_BASE_URL debe ser el mismo host donde te habilitaron la cuenta:
#   UAT:  https://api-uat.sancristobalonline.com.ar
#   Prod: https://api.sancristobal.com.ar
# Si apuntás a prod con credenciales de UAT → login o cotización fallan (401/404 según el caso).
#
# Contratos OpenAPI exportados en este repo (mismos paths bajo /b2b-gateway en cada host):
#   Documentacion/b2b-api-app.md  → B2B.Api (Auth LoginAsync, etc.)
#   Documentacion/b2b-app.md      → B2BApp (POST /api/Quoted/QuoteCA7, IssueCA7, TypeList…)
#   Documentacion/b2b-api-ca7.md  → B2B.Api.Ca7 (catálogo InfoAuto, endosos PolicyChange; sin QuoteCA7)
# Swagger UI UAT:  https://api-uat.sancristobalonline.com.ar/b2b-gateway/index.html
# Swagger UI prod: https://api.sancristobal.com.ar/b2b-gateway/index.html
#
# Sin barra final en SC_BASE_URL (la API la normaliza).
SC_BASE_URL=https://api-uat.sancristobalonline.com.ar
SC_USERNAME=B2B_SegurosAlToque
SC_PASSWORD=YOUR_PASSWORD
SC_QUOTE_PATH=/b2b-gateway/api/Quoted/QuoteCA7
# Catálogo CA7: GET /api/CatalogoVehiculos/AutosVersionPorCodigoInfoauto (ver Documentacion/b2b-api-ca7.md).
# Ramo automotor (TypeList Product): CA7CommAuto
SC_CA7_POLICY_PRODUCT=CA7CommAuto
# Planes a cotizar (TypeList CA7ProductOffering), separados por coma
SC_CA7_OFFERING_CODES=CA7_Basic
# SC_VEHICLE_LOOKUP_ENABLED=true
# SC_VEHICLE_LOOKUP_PATH=/b2b-gateway/api/CatalogoVehiculos/AutosVersionPorCodigoInfoauto
# SC_CLIENT_APP=B2BPortal
# Si sigue NullReference en QuoteCA7, probá cuerpo PascalCase como en el Swagger:
# SC_QUOTE_PASCAL_JSON=true
